{$APP_DOMAIN} {
  encode gzip zstd

  @root path /
  redir @root /?pz=1 302

  handle_path /static/* {
    root * /srv/static
    file_server
  }

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /admin/* {
    reverse_proxy backend:8000
  }

  handle * {
    reverse_proxy frontend:80
  }
}
